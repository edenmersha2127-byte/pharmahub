# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prescription_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# OCR Provider: gemini_vision | google_vision | mock
OCR_PROVIDER=gemini_vision

# Gemini Vision (primary OCR provider)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Google Cloud Vision (legacy / fallback provider — still available)
GOOGLE_VISION_API_KEY=mock-key-replace-me
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

# Mock OCR (local dev without any API key)
OCR_MOCK_ENABLED=false

# Fuzzy medicine-name matching
FUZZY_SIMILARITY_THRESHOLD=0.75
MAX_CANDIDATES_PER_MEDICINE=5

# Search Service
SEARCH_SERVICE_URL=http://search-service:8083
SEARCH_SERVICE_TIMEOUT_SECONDS=10

# File Upload
UPLOAD_DIR=./uploads/prescriptions
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
MAX_FILE_SIZE_BYTES=10485760