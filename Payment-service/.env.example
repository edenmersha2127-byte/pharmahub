# Payment Service environment. Copy to `.env` (git-ignored) and fill in real values.

# PostgreSQL (database: payment_db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Downstream services
AUTH_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Chapa (get keys from https://dashboard.chapa.co — Settings > API)
CHAPA_SECRET_KEY=replace_with_your_chapa_secret_key
CHAPA_WEBHOOK_SECRET=replace_with_your_chapa_webhook_secret
CHAPA_CALLBACK_URL=http://localhost:8088/api/payments/webhook
CHAPA_RETURN_URL=http://localhost:5173/pharmacy/subscription

# Plans / trial (optional overrides)
SUBSCRIPTION_TRIAL_DAYS=15
PLAN_MONTHLY_PRICE=1000
PLAN_YEARLY_PRICE=12000
SUBSCRIPTION_REMINDER_DAYS=3
