# Report Service environment.
# Copy this file to `.env` (which is git-ignored) and fill in real values.

# PostgreSQL (create a database named report_db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Downstream services
AUTH_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Report / moderation policy (optional overrides)
REPORT_COOLDOWN_HOURS=24
REPORT_FLAG_THRESHOLD=3
REPORT_FLAG_WINDOW_DAYS=7
REPORT_DEFAULT_SUSPENSION_DAYS=3
