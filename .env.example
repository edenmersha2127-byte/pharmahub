# ===================================================================
# MediLocator — Environment Variables Template
# ===================================================================
# Copy this file to `.env` in the repo root and fill in real values.
# NEVER commit .env — it contains secrets. Only .env.example belongs in git.
# ===================================================================


# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=medicine_locator_db


# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis_password


# ---------- JWT ----------
# Generate a secure 64+ character base64 string. Example commands:
#   PowerShell:  [Convert]::ToBase64String((1..64 | %{[byte](Get-Random -Max 256)}))
#   Linux/Mac:   openssl rand -base64 64
JWT_SECRET=replace_with_at_least_64_char_base64_secret_for_hs512_algorithm
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ---------- Mail (SMTP) ----------
# For Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password


# ---------- OCR Provider ----------
# Options: gemini_vision | google_vision | mock
OCR_PROVIDER=gemini_vision
OCR_MOCK_ENABLED=false


# ---------- Google Gemini Vision (primary OCR) ----------
# Get a free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2


# ---------- Google Cloud Vision (fallback OCR) ----------
# Optional — only needed if OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=replace_with_your_google_vision_api_key
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate


# ---------- Fuzzy Medicine Matching ----------
FUZZY_SIMILARITY_THRESHOLD=0.75
MAX_CANDIDATES_PER_MEDICINE=5


# ---------- Service URLs (local development) ----------
# Use http://localhost:<port> for local runs.
# For docker-compose, override with the service hostnames (auth-service, search-service, etc.)
AUTH_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
SEARCH_SERVICE_URL=http://localhost:8083
PRESCRIPTION_SERVICE_URL=http://localhost:8084
SEARCH_SERVICE_TIMEOUT_SECONDS=10
REST_CLIENT_TIMEOUT_SECONDS=10


# ---------- File Uploads ----------
UPLOAD_DIR=./uploads/prescriptions
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=11MB
MAX_FILE_SIZE_BYTES=10485760


# ---------- Chapa (Payment service) ----------
CHAPA_SECRET_KEY=replace_with_your_chapa_secret_key
CHAPA_WEBHOOK_SECRET=replace_with_your_chapa_webhook_secret
CHAPA_BASE_URL=https://api.chapa.co
# For docker-compose these can stay as localhost unless you deploy publicly.
CHAPA_CALLBACK_URL=http://localhost:8088/api/payments/webhook
CHAPA_RETURN_URL=http://localhost:5173/pharmacy/subscription


# ---------- App ----------
APP_BASE_URL=http://localhost:8080
